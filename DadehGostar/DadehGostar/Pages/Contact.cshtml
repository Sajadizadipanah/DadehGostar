@page
@model ContactModel

@{
    ViewData["Title"] = "تماس با ما";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">تماس با داده‌گستر</h1>
        <p class="text-muted">
            برای دریافت مشاوره و خدمات IT با ما در ارتباط باشید.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h4 class="fw-bold mb-4">اطلاعات تماس</h4>

                <p>📞 تلفن: 09129328908</p>
                <p>📧 ایمیل: sajad10375@gmail.com</p>
                <p>📍 آدرس: ایران تهران</p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h4 class="fw-bold mb-4">ساعات پاسخگویی</h4>
                <p>شنبه تا چهارشنبه</p>
                <p>۸ صبح تا ۶ عصر</p>
                <p class="text-muted">
                    آماده پاسخگویی به درخواست‌های شما هستیم.
                </p>
            </div>
        </div>

    </div>
    <div class="container mt-5">
        <div class="card border-0 shadow-sm p-4">
            <h4 class="fw-bold mb-4">ارسال پیام به ما</h4>
            @if (!string.IsNullOrEmpty(Model.ResultMessage))
            {
                <div class="alert alert-success">
                    @Model.ResultMessage
                </div>
            }
            <form method="post">

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>
                <div class="mb-3">
                    <label class="form-label">نام و نام خانوادگی</label>
                    <input type="text" class="form-control"
                           name="FullName" required />
                    <span asp-validation-for="FullName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">شماره تماس</label>
                    <input type="tel" class="form-control"
                           name="Phone" required />
                    <span asp-validation-for="Phone"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">ایمیل</label>
                    <input type="email" class="form-control"
                           name="Email" />
                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">متن پیام</label>
                    <textarea class="form-control" name="Message"
                              rows="5" required></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    ارسال پیام
                </button>

            </form>
        </div>
    </div>
</div>
