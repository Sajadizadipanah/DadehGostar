@page
@model IndexModel

@{
    ViewData["Title"] = "صفحه اصلی";
}

<div dir="rtl">

    <section class="py-5 text-white"
             style="background: linear-gradient(135deg, #101b35, #164e8a);">

        <div class="container py-5">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <span class="badge bg-primary mb-3">
                        DadehGostar Technology
                    </span>

                    <h1 class="display-4 fw-bold mb-4">
                        راهکارهای هوشمند
                        برای کسب‌وکار شما
                    </h1>

                    <p class="lead mb-4">
                        ارائه خدمات تخصصی نرم‌افزار،
                        شبکه و زیرساخت فناوری اطلاعات
                        برای رشد کسب‌وکار شما.
                    </p>

                    <a href="#services"
                       class="btn btn-primary btn-lg px-4">
                        مشاهده خدمات
                    </a>

                    <a href="#contact"
                       class="btn btn-outline-light btn-lg px-4 me-2">
                        تماس با ما
                    </a>

                </div>

            </div>

        </div>

    </section>

    
    <section id="services" class="py-5 bg-light" dir="rtl">

        <div class="container">

            <div class="text-center mb-5">
                <h2 class="fw-bold">خدمات داده‌گستر</h2>
                <p class="text-muted">
                    راهکارهای تخصصی برای توسعه کسب‌وکار شما
                </p>
            </div>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="card service-card h-100 border-0">
                        <div class="card-body p-4 text-center">
                            <h4 class="fw-bold mb-3">
                                خدمات شبکه
                            </h4>
                            <p class="text-muted">
                                طراحی، پیاده‌سازی و پشتیبانی
                                شبکه‌های کامپیوتری و زیرساخت.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card service-card h-100 border-0">
                        <div class="card-body p-4 text-center">
                            <h4 class="fw-bold mb-3">
                                توسعه نرم‌افزار
                            </h4>
                            <p class="text-muted">
                                طراحی و توسعه نرم‌افزارهای
                                اختصاصی و سامانه‌های تحت وب.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card service-card h-100 border-0">
                        <div class="card-body p-4 text-center">
                            <h4 class="fw-bold mb-3">
                                پشتیبانی IT
                            </h4>
                            <p class="text-muted">
                                نگهداری، عیب‌یابی و پشتیبانی
                                تجهیزات و سیستم‌های کامپیوتری.
                            </p>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </section>


    <section id="contact" class="container py-4">
        <h2>با ما در ارتباط باشید</h2>
    </section>

</div>
